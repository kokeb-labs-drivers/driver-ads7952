 *
 * Do not edit the generated file: the version is set once, in cmake/ads7952_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef ADS7952_VERSION_H
#define ADS7952_VERSION_H

/** Major version: incompatible API changes. */
#define ADS7952_VERSION_MAJOR @ADS7952_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define ADS7952_VERSION_MINOR @ADS7952_VERSION_MINOR@
/** Patch version: fixes. */
#define ADS7952_VERSION_PATCH @ADS7952_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define ADS7952_VERSION_STRING "@ADS7952_VERSION@"

#endif // ADS7952_VERSION_H
